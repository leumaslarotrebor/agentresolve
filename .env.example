# --- LLM provider ------------------------------------------------------
# "simulated" (default) runs a deterministic local planner so the whole
# project works out of the box with no API key.
# "anthropic" uses real Claude tool-calling — set ANTHROPIC_API_KEY too.
LLM_PROVIDER=simulated
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_MAX_TOOL_ITERATIONS=8

# --- Business rules ------------------------------------------------------
REFUND_AUTO_APPROVAL_THRESHOLD_EUR=100.0
REPLACEMENT_WINDOW_DAYS=30
REFUND_WINDOW_DAYS=30

# --- App -------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
